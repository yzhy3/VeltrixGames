rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCreator() {
      return signedIn() && exists(/databases/$(database)/documents/creators/$(request.auth.uid));
    }
    function isAdmin() {
      return isCreator()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function notBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    match /creators/{uid} {
      allow read: if true;
      allow write: if isCreator();
    }
    match /admins/{uid} {
      allow read: if true;
      allow write: if isCreator();
    }
    match /bans/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /usernames/{uname} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && uname.matches("^[a-z0-9_]{3,20}$");
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30;
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30
          && (!("bio" in request.resource.data) || request.resource.data.bio.size() <= 160)
          && (!("verified" in request.resource.data) || request.resource.data.verified == resource.data.verified)
        ) || (isAdmin())
      );
      allow delete: if isAdmin() && !exists(/databases/$(database)/documents/creators/$(uid));
    }
    match /moderations/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if signedIn();
    }
    match /downloads/{id} {
      allow read: if true;
      allow create, update: if true;
    }
    match /games/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow create, update: if signedIn() && notBanned()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.game_id + "_" + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /chat/{id} {
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow update: if signedIn() && notBanned()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && notBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if signedIn() && (
        resource.data.to == request.auth.uid || resource.data.from == request.auth.uid
      );
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    match /friends/{uid}/list/{friendId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && (request.auth.uid == uid || request.auth.uid == friendId);
    }
    match /dms/{chatId} {
      allow read, write: if signedIn();
      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && notBanned()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }
  }
}
