rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCreator() {
      return signedIn() && exists(/databases/$(database)/documents/creators/$(request.auth.uid));
    }
    function isAdmin() {
      return isCreator()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function notBanned() {
      return signedIn() && !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    match /creators/{uid} {
      allow read: if true;
      allow write: if isCreator();
    }
    match /admins/{uid} {
      allow read: if true;
      allow write: if isCreator();
    }
    match /bans/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 160);
      allow delete: if false;
    }
    match /downloads/{id} {
      allow read: if true;
      allow create, update: if true;
    }
    match /games/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow create, update: if signedIn() && notBanned()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.game_id + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
    match /chat/{id} {
      allow read: if true;
      allow create: if signedIn() && notBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow update: if signedIn() && notBanned()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
